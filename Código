##Interpolar al grid del entrenamiento
```{r}
colnames(X_comercial) <- as.character(colnames(X_comercial))
colnames_entrenamiento <- as.character(colnames(test.Xpda))

lambda_train <- as.numeric(colnames_entrenamiento)
lambda_comercial <- as.numeric(colnames(X_comercial))
interpolar_espectro <- function(y, x_old, x_new) {
  approx(x = x_old, y = y, xout = x_new, rule = 2)$y
}
X_comercial_interp <- t(apply(X_comercial, 1, function(espectro) {
  interpolar_espectro(espectro, lambda_comercial, lambda_train)
}))
